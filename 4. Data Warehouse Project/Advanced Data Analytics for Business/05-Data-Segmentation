/* =========================================================
   Script Purpose: Data Segmentation (Gold Layer)
   =========================================================
   This script demonstrates two common segmentation techniques
   using the Gold layer dimension and fact tables:

   Part A) Product Cost Segmentation
   --------------------------------
   Goal:
   - Bucket products into cost ranges to understand how the
     product portfolio is distributed by cost.

   Logic:
   - Uses CASE to assign each product to a cost_range:
       * Below 100
       * 100–500
       * 500–1000
       * Above 1000
   Output:
   - Counts how many products fall into each cost_range.

   Part B) Customer Spending Segmentation
   -------------------------------------
   Goal:
   - Segment customers based on spending value and relationship
     length (lifespan).

   Inputs:
   - gold.fact_sales      : sales_amount and order_date history
   - gold.dim_customers   : customer identifiers (customer_key)

   Metrics calculated per customer:
   - total_spending : SUM(sales_amount)
   - first_order    : MIN(order_date)
   - last_order     : MAX(order_date)
   - lifespan       : months between first and last order (DATEDIFF)

   Segments:
   - VIP     : lifespan >= 12 months AND total_spending > 5000
   - Regular : lifespan >= 12 months AND total_spending <= 5000
   - New     : lifespan < 12 months

   Notes:
   - Lifespan uses DATEDIFF(month, first_order, last_order), which counts
     month boundaries (not exact day-based months).
   - Ensure order_date is not NULL if your dataset contains null dates.
   - If you want “New” to include customers with only 1 order, this logic
     already handles it (lifespan will be 0).
   ========================================================= */

-- =========================================================
-- Part A: Segment products by cost ranges
-- =========================================================
WITH product_segments AS (
    SELECT
        product_key,
        product_name,
        cost,
        CASE
            WHEN cost < 100 THEN 'Below 100'
            WHEN cost BETWEEN 100 AND 500 THEN '100-500'
            WHEN cost BETWEEN 500 AND 1000 THEN '500-1000'
            ELSE 'Above 1000'
        END AS cost_range
    FROM gold.dim_products
)
SELECT
    cost_range,
    COUNT(product_key) AS total_products
FROM product_segments
GROUP BY cost_range
ORDER BY total_products DESC;

-- =========================================================
-- Part B: Segment customers by spending and lifespan
-- =========================================================
WITH customer_spending AS (
    SELECT
        c.customer_key,
        SUM(f.sales_amount) AS total_spending,
        MIN(f.order_date) AS first_order,
        MAX(f.order_date) AS last_order,
        DATEDIFF(month, MIN(f.order_date), MAX(f.order_date)) AS lifespan
    FROM gold.fact_sales f
    LEFT JOIN gold.dim_customers c
        ON f.customer_key = c.customer_key
    WHERE f.order_date IS NOT NULL
    GROUP BY c.customer_key
)
SELECT
    customer_segment,
    COUNT(customer_key) AS total_customers
FROM (
    SELECT
        customer_key,
        CASE
            WHEN lifespan >= 12 AND total_spending > 5000 THEN 'VIP'
            WHEN lifespan >= 12 AND total_spending <= 5000 THEN 'Regular'
            ELSE 'New'
        END AS customer_segment
    FROM customer_spending
) t
GROUP BY customer_segment
ORDER BY total_customers DESC;
